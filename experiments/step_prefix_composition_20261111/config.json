{
  "analysis": "Three-outcome composition of Step/Prefix labels",
  "models": [
    "deepseek_r1_distill_llama_8b",
    "gemma_4_31b_it",
    "qwen3_8_27b"
  ],
  "domains": [
    "Math",
    "Science",
    "Logic",
    "Multi-hop",
    "Factuality"
  ],
  "splits": [
    "train",
    "val",
    "test"
  ],
  "test_included": true,
  "unit": "retained Step position",
  "classes": {
    "new": "labels.step[t]=1",
    "inherited": "labels.step[t]=0 and labels.prefix[t]=1",
    "clean": "labels.prefix[t]=0"
  },
  "inherited_share": "inherited / (new + inherited)",
  "primary_aggregation": "Union of TRAIN, VAL and TEST",
  "data_and_labels_changed": false,
  "closing_statistics": {
    "correction": "Prefix 1->0 transition between consecutive retained positions",
    "recovered_clean": "labels.prefix[t]=0 and labels.prefix[s]=1 for some earlier retained position s<t"
  },
  "figure": "result/figure.pdf, result/figure.png"
}
