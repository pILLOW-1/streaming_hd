{
  "model": "Qwen3.8-27B",
  "model_revision": "1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0",
  "dataset_revision": "b45b2fd88e00869825de163bc6b7a41f31dd962b",
  "domains": ["Logic", "Factuality"],
  "readouts": ["last_token", "streaming_step", "streaming_prefix"],
  "prefix_log_weight_per_token": 0.003,
  "native_layer_range": [1, 64],
  "head": "linear_one_logit",
  "pooling_log_weight_range": [0, 3],
  "input_normalization": "position_l2",
  "fit_split": "train",
  "evaluation_split": "val",
  "eligible": "previous_original_step_C == 1 and current_Y == 0",
  "target": "current_C",
  "seed": 42,
  "optimizer": "observed_lbfgs",
  "line_search": "strong_wolfe",
  "learning_rate": 1.0,
  "max_iterations": 100,
  "batch": "full",
  "loss": "binary_cross_entropy_with_logits",
  "half_squared_parameter_norm_coefficient": 0.0001,
  "selection": ["VAL AUROC", "VAL AP"],
  "saplma": {
    "readout": "last_token",
    "input_normalization": "none",
    "hidden_widths": [256, 128, 64],
    "activation": "relu",
    "initialization": "xavier_uniform_zero_bias",
    "optimizer": "keras_adam",
    "learning_rate": 0.001,
    "betas": [0.9, 0.999],
    "epsilon_hat": 0.0000001,
    "batch_size": 32,
    "epochs": 5
  }
}
